# Kalshi API credentials — from Account & Security → API Keys in Kalshi dashboard
KALSHI_API_KEY_ID=your-api-key-id-here

# Full PEM content of your downloaded private key file.
# In GitHub Actions, paste the entire file content as a secret.
# For local testing, set this to the file content (including header/footer lines).
KALSHI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----
...paste key content here...
-----END RSA PRIVATE KEY-----

# How long (seconds) the streamer runs before exiting gracefully.
# Default 21000 ≈ 5h 50m (just under GitHub Actions' 6h job limit).
STREAM_DURATION_SECONDS=21000
